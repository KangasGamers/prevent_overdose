# Form submissions (get-narcan, volunteer, contact, newsletter, event-notify,
# training-cert, workshop-register, workshop-host) are delivered by email.
#
# Pick ONE backend:
#
# --- Option A: Google Workspace / Gmail over SMTP (no DNS setup) -------------
#  1. On the Google account that owns FORMS_FROM_EMAIL, turn on 2-Step
#     Verification, then create an App Password (Google Account -> Security ->
#     App passwords). It's a 16-character string.
#  2. Fill in the SMTP_* vars below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=leadership@preventoverdose.co
SMTP_PASS=your-16-char-app-password

# --- Option B: Resend (needs a verified sending domain) ---------------------
#  Leave this blank if you're using SMTP. If both are set, SMTP wins.
#  RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Required for either option --------------------------------------------
# Where submissions are sent. Comma-separated for more than one recipient.
FORMS_TO_EMAIL=leadership@preventoverdose.co

# The "From" address on the notification email. For SMTP this should be the
# SMTP_USER address (or an alias it can send as); for Resend its domain must be
# verified in Resend.
FORMS_FROM_EMAIL=leadership@preventoverdose.co

# --- Supabase: stores every submission + workshop registrations -------------
# Optional. Without it the site still emails; with it, submissions also land in
# Postgres and the /workshops page shows live registration counts.
#  1. Create a free project at https://supabase.com
#  2. Run supabase/schema.sql in the SQL Editor
#  3. Project Settings -> API: copy the URL and the service_role key (secret!)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
