# Form submissions (get-narcan, volunteer, contact, newsletter, event notify)
# are delivered by email through Resend — https://resend.com
#
# 1. Create a Resend account and an API key: https://resend.com/api-keys
# 2. Add and verify the sending domain (preventoverdose.co) under Domains,
#    following the DNS records Resend gives you.
# 3. Set these three vars locally in .env.local and in the Vercel project
#    (Settings -> Environment Variables).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where submissions are sent. Comma-separated for more than one recipient.
FORMS_TO_EMAIL=leadership@preventoverdose.co

# The "from" address. Its domain must be verified in Resend.
FORMS_FROM_EMAIL=forms@preventoverdose.co
